# Groq API Keys (multiple keys separated by comma for key rotation)
GROQ_API_KEYS=groq_key1,groq_key2,groq_key3
# OR single key (fallback)
GROQ_API_KEY=your_groq_api_key_here

# Port for the server
PORT=3000

# Supabase credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL for self-ping cron job (e.g., https://your-app.onrender.com)
BASE_URL=http://localhost:3000
